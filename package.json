{
  "name": "openpanel-cli",
  "version": "0.3.0",
  "description": "Command-line tool to create, manage, and pull data from OpenPanel dashboards, reports, and notification rules via the OpenPanel internal API.",
  "type": "module",
  "bin": {
    "openpanel": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "openpanel",
    "analytics",
    "cli",
    "dashboards",
    "reports",
    "notifications"
  ],
  "license": "MIT",
  "author": "Parikshit Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parikshit223933/openpanel-cli.git"
  },
  "homepage": "https://github.com/parikshit223933/openpanel-cli#readme",
  "bugs": {
    "url": "https://github.com/parikshit223933/openpanel-cli/issues"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "superjson": "^2.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
